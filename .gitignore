# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets — never commit real environment files (the .env.example files ARE committed)
.env
.env.*
!.env.example

# Customer documents and data
backend/uploads/
uploads/
backups/

# Local backups of old versions (contain old .env files)
_archive/

# Logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Built frontend copied in by the Azure deploy workflow
backend/public/

# Tally connector: its settings hold the connector key; state and logs are per machine
connector/config.json
connector/state.json
connector/logs/
