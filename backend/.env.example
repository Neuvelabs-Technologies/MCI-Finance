# --- Server ---
PORT=4000
NODE_ENV=development
# Public address customers open (no trailing slash): the FRONTEND URL.
# Dev: the Vite frontend on 5173. Docker: wherever the frontend container is published (e.g. https://einvoice.wearemci.com).
PUBLIC_BASE_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
# Set to true when served over HTTPS
COOKIE_SECURE=false

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/mci_einvoice
# USE_MEMORY_DB=1   # throwaway in-memory MongoDB for quick local testing

# --- Uploaded documents (keep private, back up regularly). Relative paths are inside backend/ ---
UPLOAD_DIR=./uploads
# Per-file upload limit in MB. 0 = no limit (any size). Programs and scripts are always refused.
MAX_FILE_MB=0

# --- First admin user (created on first start only) ---
ADMIN_EMAIL=finance@wearemci.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Finance Admin

# --- Email (Microsoft 365 example). Leave SMTP_HOST empty to print emails to the console instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MCI Middle East – Accounts <accounts@wearemci.com>"
# Who gets notified when a customer submits (comma-separated)
NOTIFY_EMAILS=

# --- Operations ---
# LOG_LEVEL=info              # debug | info | warn | error (JSON logs in production)
# Sample customers for training/demos. Always allowed outside production;
# on a live server only when this is true (use it on a staging server, not the live one).
# ALLOW_DEMO_DATA=false
# One-click "Quick sign-in" on the login page, no password. Always on in development;
# on a production server only when true — for a staging/demo server, NEVER the live one.
# QUICK_LOGIN=false
# With USE_MEMORY_DB=1, demo data loads automatically; set DEMO_DATA=0 to start empty.
# DEMO_DATA=1
