# Serves the built React app and forwards /api to the backend.
# ${BACKEND_URL} is filled in from the environment when the container starts.

server {
  listen 80;
  server_name _;
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  root /usr/share/nginx/html;

  # No size limit on uploads (the backend has MAX_FILE_MB if one is ever needed).
  # Large scans on slow connections need generous timeouts.
  client_max_body_size 0;
  client_body_timeout 300s;

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Hashed build files never change
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # MCI logo and artwork (also used in emails)
  location /brand/ {
    add_header Cache-Control "public, max-age=86400";
    try_files $uri =404;
  }

  # Everything else is the single-page app
  location / {
    add_header Cache-Control "no-store";
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header Referrer-Policy "no-referrer";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'";
    try_files $uri /index.html;
  }
}
